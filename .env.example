# Supabase Configuration
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Google Gemini AI Configuration
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Khaya AI API Configuration
# Supports: English, Twi, Dagbani, and 10+ other Ghanaian languages
# Get your API key from: https://developer-api.khaya.ai
KHAYA_API_KEY=your-khaya-api-key-here

# Optional: OpenAI API Key for Whisper transcription
# Only needed if you prefer OpenAI over Khaya for English transcription
# Get from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-api-key-here
